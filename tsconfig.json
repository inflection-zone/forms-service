{
    "compilerOptions": {
        "declaration": true,
        "incremental": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "module": "commonjs",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "node",
        "target": "es2022",
        "lib": [
            "es2022"
        ],
        "noImplicitAny": false,
        "sourceMap": true,
        "alwaysStrict": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "dist/",
        "baseUrl": ".",
        "paths": {
            "*": [
                "node_modules/*"
            ]
        },
        "typeRoots": [
            "@types",
            "node_modules/@types"
        ],
        "types": [
            "node"
        ],
        "downlevelIteration": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "tests/api-tests/tests/*"
    ],
    "exclude": [
        "node_modules/**/*",
        "dist/**/*"
    ]
}
