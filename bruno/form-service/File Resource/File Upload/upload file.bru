meta {
  name: upload file
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/file-resources/upload
  body: multipartForm
  auth: none
}

body:multipart-form {
  UserId: {{USER_ID}}
  IsPublicResource: true
  Name: @file(C:\Users\Prashant Kharade\OneDrive\Pictures\1694802364088.jpg)
  IsMultiResolutionImage: false
}

script:post-response {
  try {
      var jsonRes = res.getBody();
      bru.setEnvVar("FILE_RESOURCE_ID", jsonRes.Data.id);
  }
  catch (error) {
      console.log(error.message);
  }
  
  test("Request is successfull", function () {
      expect(res.getStatus()).to.equal(201);
      var jsonRes = res.getBody();
      expect(jsonRes.Status).to.eql('Success');
  });
}
